{
  "rules": {
    "entries": {
      ".read": "(auth != null && auth.token.email_verified == true && (auth.token.email == 'x2clemens@gmail.com' || auth.token.email == 'bergosi1212@gmail.com' || auth.token.email == 'manuel.kemmer@kemedia.at' || auth.token.email == 'ragon.din@gmx.at')) || (auth != null && auth.token.email_verified == true && (auth.token.email == 'kemplsophie@gmail.com'))",
      "$id": {
        ".write": "auth != null && auth.token.email_verified == true && (auth.token.email == 'x2clemens@gmail.com' || auth.token.email == 'bergosi1212@gmail.com' || auth.token.email == 'manuel.kemmer@kemedia.at' || auth.token.email == 'ragon.din@gmx.at') && $id.length < 40",
        ".validate": "newData.hasChildren(['ts', 'person', 'brand', 'flavor', 'cents'])",
        "ts": {
          ".validate": "newData.isNumber()"
        },
        "person": {
          ".validate": "newData.isString() && newData.val().length < 30"
        },
        "brand": {
          ".validate": "newData.val() === 'redbull' || newData.val() === 'clever' || newData.val() === 'sbudget' || newData.val() === 'other'"
        },
        "flavor": {
          ".validate": "newData.isString() && newData.val().length < 60"
        },
        "cents": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 1000"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "pending": {
      ".read": "auth != null && auth.token.email_verified == true && (auth.token.email == 'x2clemens@gmail.com')",
      "$uid": {
        ".read": "auth != null && auth.token.email_verified == true && (auth.token.email == 'kemplsophie@gmail.com') && auth.uid === $uid",
        "$id": {
          ".write": "(auth != null && auth.token.email_verified == true && (auth.token.email == 'x2clemens@gmail.com')) || (auth != null && auth.token.email_verified == true && (auth.token.email == 'kemplsophie@gmail.com') && auth.uid === $uid && !data.exists() && $id.length < 40)",
          ".validate": "newData.hasChildren(['ts', 'person', 'brand', 'flavor', 'cents', 'by', 'status'])",
          "ts": {
            ".validate": "newData.isNumber()"
          },
          "person": {
            ".validate": "newData.isString() && newData.val().length < 30"
          },
          "brand": {
            ".validate": "newData.val() === 'redbull' || newData.val() === 'clever' || newData.val() === 'sbudget' || newData.val() === 'other'"
          },
          "flavor": {
            ".validate": "newData.isString() && newData.val().length < 60"
          },
          "cents": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 1000"
          },
          "by": {
            ".validate": "newData.isString() && (newData.val() === auth.token.email || newData.val() === data.val())"
          },
          "status": {
            ".validate": "newData.val() === 'offen' || ((auth != null && auth.token.email_verified == true && (auth.token.email == 'x2clemens@gmail.com')) && (newData.val() === 'angenommen' || newData.val() === 'abgelehnt'))"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
